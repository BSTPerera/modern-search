<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Modern Search</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #0f0f0f;
      color: #e0e0e0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      min-height: 100vh;
      padding: 60px 20px;
    }
    h1 { font-size: 2.4rem; color: #ffffff; margin-bottom: 8px; }
    p.subtitle { color: #888; margin-bottom: 36px; font-size: 0.95rem; }
    form {
      display: flex;
      gap: 10px;
      width: 100%;
      max-width: 560px;
      margin-bottom: 40px;
    }
    input[type="text"] {
      flex: 1;
      padding: 12px 18px;
      border-radius: 8px;
      border: 1px solid #333;
      background: #1a1a1a;
      color: #fff;
      font-size: 1rem;
      outline: none;
      transition: border 0.2s;
    }
    input[type="text"]:focus { border-color: #6c63ff; }
    button {
      padding: 12px 24px;
      border-radius: 8px;
      border: none;
      background: #6c63ff;
      color: #fff;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:hover { background: #5548d9; }
    .results {
      width: 100%;
      max-width: 560px;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      border-radius: 10px;
      padding: 20px 24px;
    }
    .results p { font-size: 0.85rem; color: #666; margin-bottom: 8px; }
    .results .query-output {
      font-size: 1.1rem;
      color: #c8c8ff;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <h1>Modern Search</h1>
  <p class="subtitle">A fast, minimal search interface</p>

  <form action="/search" method="GET">
    <input type="text" name="q" id="search-input" placeholder="Search anything..." value="<%= query %>" autocomplete="off" />
    <button type="submit" id="search-btn">Search</button>
  </form>

  <% if (query) { %>
  <div class="results" id="results-box">
    <p>Results for:</p>
    <div class="query-output" id="query-output"><%- query %></div>
  </div>
  <% } %>
</body>
</html>
